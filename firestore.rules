rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // TODO (Jules): [Security & Validation] Restrict read/write access based on authentication state (request.auth != null) and implement data ownership logic (e.g., resource.data.userId == request.auth.uid) so users can only access their own CRM data.
      allow read, write: if true;
    }
  }
}
